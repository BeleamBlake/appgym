<?xml version="1.0" encoding="utf-8"?>
<!-- CAMBIOS DE INTERFAZ CHIDO: Perfil adaptado al estilo visual de Clases -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context="Perfil">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CAMBIOS DE INTERFAZ CHIDO: Header con el mismo estilo de Clases -->

            <!-- CAMBIOS DE INTERFAZ CHIDO: Tarjeta principal superpuesta al header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_redondeado"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Membresía -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/formulario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membresia_label" />

                        <TextView
                            android:id="@+id/txt_estado"
                            style="@style/estado_activo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_header_morado"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="34dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="Perfil"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/btn_cerrar_sesion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_logout" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        style="@style/relleno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/miembro_label" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="18dp" />

                <!-- Avatar + datos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/avatar_placeholder"
                            app:shapeAppearanceOverlay="@style/CircleImageStyle" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="6dp" />

                        <TextView
                            style="@style/relleno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/editar" />

                    </LinearLayout>

                    <View
                        android:layout_width="18dp"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/relleno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/miembro_label" />

                        <TextView
                            android:id="@+id/txt_nombre_miembro"
                            style="@style/nombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="8dp" />

                        <TextView
                            style="@style/relleno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/correo_label" />

                        <TextView
                            android:id="@+id/txt_correo"
                            style="@style/nombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <!-- Fecha de nacimiento -->
                <TextView
                    style="@style/relleno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fecha_nacimiento_label" />

                <TextView
                    android:id="@+id/txt_fecha_nacimiento"
                    style="@style/nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <!-- Contacto -->
                <TextView
                    style="@style/relleno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contacto_label" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txt_contacto"
                        style="@style/nombre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <ImageView
                        android:id="@+id/btn_editar_contacto"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_pencil" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="16dp"/>

            <!-- CAMBIOS DE INTERFAZ CHIDO: Botón estilo tarjeta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_redondeado"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/numero_membresia_label"
                    style="@style/relleno"/>

                <TextView
                    android:id="@+id/txt_num_membresia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    style="@style/nombre"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>

                <Button
                    android:id="@+id/btn_cambiar_pass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/accent_red"
                    android:text="@string/bt_cambiar_pass"
                    android:textAllCaps="false"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="18dp"/>

            <!-- CAMBIOS DE INTERFAZ CHIDO: Resumen de actividad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_redondeado"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/registro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/resumen_actividad_label"/>

                    <TextView
                        style="@style/registro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/actividad_header"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"/>

                <!-- Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/act_box"
                        style="@style/nombre"/>

                    <CheckBox
                        android:id="@+id/chk_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:buttonTint="@color/color_check"/>

                </LinearLayout>

                <!-- Spinning -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/act_spinning"
                        style="@style/nombre"/>

                    <CheckBox
                        android:id="@+id/chk_spinning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:buttonTint="@color/color_check"/>

                </LinearLayout>

                <!-- Yoga -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/act_yoga"
                        style="@style/nombre"/>

                    <CheckBox
                        android:id="@+id/chk_yoga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:buttonTint="@color/color_check"/>

                </LinearLayout>

                <!-- Crossfit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/act_crossfit"
                        style="@style/nombre"/>

                    <CheckBox
                        android:id="@+id/chk_crossfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:buttonTint="@color/color_check"/>

                </LinearLayout>

                <!-- Pesas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/act_pesas"
                        style="@style/nombre"/>

                    <CheckBox
                        android:id="@+id/chk_pesas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:buttonTint="@color/color_check"/>

                </LinearLayout>

                <!-- Cardio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/act_cardio"
                        style="@style/nombre"/>

                    <CheckBox
                        android:id="@+id/chk_cardio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:buttonTint="@color/color_check"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="18dp"/>

            <!-- CAMBIOS DE INTERFAZ CHIDO: Clases en racha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_redondeado"
                android:elevation="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/clases_racha_label"
                    style="@style/nombre"
                    />

                <TextView
                    android:id="@+id/txt_clases_racha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clases_racha_ejemplo"
                    style="@style/nombre"/>

            </LinearLayout>
<LinearLayout
    android:id="@+id/btn_mis_reservas"
    android:layout_marginTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:padding="16dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_redondeado"

    >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis Reservas"
        android:layout_gravity="center_vertical"
        style="@style/nombre"
        />
</LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="20dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>