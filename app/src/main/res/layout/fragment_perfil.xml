<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Perfil">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="15dp"/>

            <!-- ===== Fila: Membresia / Estado ... Cerrar sesion ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/membresia_label"
                        style="@style/formulario"/>

                    <TextView
                        android:id="@+id/txt_estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/membresia_activa"
                        style="@style/estado_activo"/>

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/btn_cerrar_sesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_logout"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cerrar_sesion"
                        style="@style/relleno"/>

                </LinearLayout>

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"/>

            <!-- ===== Fila: Avatar + datos del miembro ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_avatar"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/editar"
                        style="@style/relleno"/>

                </LinearLayout>

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/miembro_label"
                        style="@style/relleno"/>

                    <TextView
                        android:id="@+id/txt_nombre_miembro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nombre_ejemplo"
                        style="@style/nombre"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correo_label"
                        style="@style/relleno"/>

                    <TextView
                        android:id="@+id/txt_correo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correo_ejemplo"
                        style="@style/nombre"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fecha_nacimiento_label"
                        style="@style/relleno"/>

                    <TextView
                        android:id="@+id/txt_fecha_nacimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fecha_ejemplo"
                        style="@style/nombre"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="24dp"/>

            <!-- ===== Fila: Contacto ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contacto_label"
                    style="@style/relleno"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txt_contacto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contacto_ejemplo"
                        style="@style/nombre"/>

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp"/>

                    <ImageView
                        android:id="@+id/btn_editar_contacto"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_pencil"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="24dp"/>

            <!-- ===== Boton cambiar contraseña ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <Button
                    android:id="@+id/btn_cambiar_pass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/boton_gris"
                    android:text="@string/bt_cambiar_pass"
                    android:textAllCaps="false"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="24dp"/>

            <!-- ===== Numero de membresia ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/numero_membresia_label"
                    style="@style/relleno"/>

                <TextView
                    android:id="@+id/txt_num_membresia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/numero_membresia_ejemplo"
                    style="@style/nombre"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="28dp"/>

            <!-- ===== Resumen de actividad ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp" />

                <TextView
                    style="@style/registro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resumen_actividad_label" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/registro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/actividad_header" />

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="10dp"/>

            <!-- Fila 1: clase de box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/act_box"
                    style="@style/nombre"/>

                <CheckBox
                    android:id="@+id/chk_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:buttonTint="@color/color_check"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <!-- Fila 2: Sppinig -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/act_spinning"
                    style="@style/nombre"/>

                <CheckBox
                    android:id="@+id/chk_spinning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:buttonTint="@color/color_check"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <!-- Fila 3: yoga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/act_yoga"
                    style="@style/nombre"/>

                <CheckBox
                    android:id="@+id/chk_yoga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:buttonTint="@color/color_check"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <!-- Fila 4: crossfit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/act_crossfit"
                    style="@style/nombre"/>

                <CheckBox
                    android:id="@+id/chk_crossfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:buttonTint="@color/color_check"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <!-- Fila 5: Pesas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/act_pesas"
                    style="@style/nombre"/>

                <CheckBox
                    android:id="@+id/chk_pesas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:buttonTint="@color/color_check"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <!-- Fila 6: Cardio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/act_cardio"
                    style="@style/nombre"/>

                <CheckBox
                    android:id="@+id/chk_cardio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:buttonTint="@color/color_check"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"/>

            <!-- ===== Clases en racha ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="15dp"
                    android:layout_height="0dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clases_racha_label"
                    style="@style/nombre"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txt_clases_racha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clases_racha_ejemplo"
                    style="@style/nombre"/>

                <View
                    android:layout_width="40dp"
                    android:layout_height="0dp"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>