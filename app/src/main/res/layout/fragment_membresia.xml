<?xml version="1.0" encoding="utf-8"?>
<!-- CAMBIOS DE INTERFAZ CHIDO: ajustes visuales de color/fuente. -->

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".Membresia">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ===== Fila: Membresia / Estado ... Cerrar sesion (siempre visible) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingBottom="34dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/bg_header_morado">


            <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Membresía"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>


                </LinearLayout>






            <!-- ============================================================ -->
            <!-- ===== Vista 1: Fechas del plan actual (se ve al abrir)  ===== -->
            <!-- ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/bg_tarjeta_clase"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membresia: "
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_estado_membresia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INACTIVA"
                        android:textColor="@color/danger"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="vertical"
                   android:background="@drawable/bg_tarjeta_clase"
                   android:layout_marginBottom="10dp">
                   <LinearLayout
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:orientation="horizontal"
                       android:layout_gravity="center_horizontal">
                <TextView
                    android:id="@+id/txt_miembro_desde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Miembro desde: "
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17/08/2026 "
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"/>
                   </LinearLayout>
                   <LinearLayout
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:orientation="horizontal"
                       android:layout_gravity="center_horizontal">
                    <TextView
                        android:id="@+id/txt_inicio_plan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inicio de plan actual: "
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18/08/2026 "
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"/>
                   </LinearLayout>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_gravity="center_horizontal">
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Proxima Fecha de Renovacion: "
                       android:textSize="16sp"
                       android:textStyle="bold"
                       android:textColor="@color/text_primary"/>
                    <TextView
                        android:id="@+id/txt_proxima_renovacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21/08/2026"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
</LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_marginTop="5dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_tarjeta_clase"
                    >
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan Actual: "
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/txt_plan_actual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premiun Pro Max Mameitor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>

           <LinearLayout
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:paddingEnd="5dp"
                        android:src="@drawable/ic_pesa_historial"/>



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beneficios del plan actual"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

           </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•  Clases ilimitadas"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•  Suplementos ilimitados"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•  Acceso a maquinas sin restriccion"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="•  Prioridad a reserva de clases"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>


                    <TextView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/btn_ver_membresias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver Membresias"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/boton_rojo_registrar"/>
                </LinearLayout>
                </LinearLayout>


--




            <!-- ================================================================= -->
            <!-- ===== Vista 2: Tarjetas de planes (oculta hasta tocar el boton) === -->
            <!-- ================================================================= -->
            <LinearLayout
                android:id="@+id/vista_tarjetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Tarjeta 1: Membresia Ruedas de Entrenamiento -->
                <LinearLayout
                    android:id="@+id/header_plan1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/fondo_rueditas">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Membresia Ruedas de Entrenamiento"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <ImageView
                        android:id="@+id/icono_flecha_plan1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_derecha"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_plan1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proxima Fecha de Renovacion: 21/01/2010"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan Actual: Premiun Pro Max Mameitor"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Clases ilimitadas"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Suplementos ilimitados"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="16dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seleccionar Plan"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:background="@drawable/fondo_rueditas"/>

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"/>

                <!-- Tarjeta 2: Membresia Chosa de los pequeñoines -->
                <LinearLayout
                    android:id="@+id/header_plan2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/fondo_choza">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Membresia Chosa de los pequeñoines"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <ImageView
                        android:id="@+id/icono_flecha_plan2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_derecha"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_plan2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proxima Fecha de Renovacion: 03/02/2010"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan Actual: Chosa de los pequeñoines"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Suplementos ilimitados"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Acceso a maquinas sin restriccion"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Prioridad a reserva de clases"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="16dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seleccionar Plan"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:background="@drawable/fondo_choza"/>

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"/>

                <!-- Tarjeta 3: Membresia Pro Max Mameitor -->
                <LinearLayout
                    android:id="@+id/header_plan3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/fondo_mameitor">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Membresia Pro Max Mameitor"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <ImageView
                        android:id="@+id/icono_flecha_plan3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_derecha"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/body_plan3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proxima Fecha de Renovacion: 21/01/2010"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan Actual: Premiun Pro Max Mameitor"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Clases ilimitadas"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Suplementos ilimitados"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Acceso a maquinas sin restriccion"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Prioridad a reserva de clases"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="16dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seleccionar Plan"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:background="@drawable/boton_rojo_registrar"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            </LinearLayout>



    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>