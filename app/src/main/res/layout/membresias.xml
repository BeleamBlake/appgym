<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Membresia">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===================================================== -->
            <!-- ===== Tarjeta 1: Membresia Ruedas de Entrenamiento === -->
            <!-- ===================================================== -->
            <LinearLayout
                android:id="@+id/header_plan1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/fondo_rueditas">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Membresia Ruedas de Entrenamiento"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/icono_flecha_plan1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_derecha"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/body_plan1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxima Fecha de Renovacion: 21/01/2010"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan Actual: Premiun Pro Max Mameitor"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Clases ilimitadas"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Suplementos ilimitados"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar Plan"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/fondo_rueditas"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="14dp"/>

            <!-- ===================================================== -->
            <!-- ===== Tarjeta 2: Membresia Chosa de los pequeñoines == -->
            <!-- ===================================================== -->
            <LinearLayout
                android:id="@+id/header_plan2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/fondo_choza">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Membresia Choza de los pequeñoines"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/icono_flecha_plan2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_derecha"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/body_plan2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxima Fecha de Renovacion: 03/02/2010"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan Actual: Chosa de los pequeñoines"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Suplementos ilimitados"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Acceso a maquinas sin restriccion"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Prioridad a reserva de clases"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver Membresias"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/boton_rojo_registrar"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="14dp"/>

            <!-- ===================================================== -->
            <!-- ===== Tarjeta 3: Membresia Pro Max Mameitor ========== -->
            <!-- ===================================================== -->
            <LinearLayout
                android:id="@+id/header_plan3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/fondo_mameitor">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Membresia Pro Max Mameitor"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/icono_flecha_plan3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_derecha"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/body_plan3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxima Fecha de Renovacion: 21/01/2010"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan Actual: Premiun Pro Max Mameitor"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Clases ilimitadas"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Suplementos ilimitados"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Acceso a maquinas sin restriccion"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Prioridad a reserva de clases"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar Plan"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/fondo_boton"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>