<?xml version="1.0" encoding="utf-8"?>
<!-- CAMBIOS DE INTERFAZ CHIDO: item para historial de membresías -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="14dp">

    <!-- ===== Encabezado del plan ===== -->
    <LinearLayout
        android:id="@+id/header_historial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="@drawable/fondo_rueditas">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_plan_historial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Membresía Ruedas de Entrenamiento"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txt_estado_historial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Membresía finalizada"
                android:textColor="@color/text_primary"
                android:textSize="12sp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/icono_flecha_historial"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_derecha"/>

    </LinearLayout>


    <!-- ===== Información del plan ===== -->
    <LinearLayout
        android:id="@+id/body_historial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_fecha_inicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha de inicio: 05/05/2026"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>

        <View
            android:layout_width="0dp"
            android:layout_height="8dp"/>

        <TextView
            android:id="@+id/txt_fecha_fin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha de finalización: 05/06/2026"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>

        <View
            android:layout_width="0dp"
            android:layout_height="8dp"/>

        <TextView
            android:id="@+id/txt_duracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duración: 30 días"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>

        <View
            android:layout_width="0dp"
            android:layout_height="8dp"/>

        <TextView
            android:id="@+id/txt_precio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio pagado: $500.00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <View
            android:layout_width="0dp"
            android:layout_height="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beneficios:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/txt_beneficios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• Clases ilimitadas&#10;• Suplementos ilimitados"
            android:textSize="14sp"
            android:textColor="@color/text_primary"/>

    </LinearLayout>

</LinearLayout>