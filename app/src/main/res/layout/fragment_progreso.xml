<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Progreso">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="0dp"
            android:layout_height="15dp"/>

        <!-- ===== Fila: Membresia / Estado ... Cerrar sesion ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="15dp"
                android:layout_height="0dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Membresia:"
                    android:textSize="16sp"
                    android:textColor="#000000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_logout"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cerrar sesion"
                    android:textSize="11sp"
                    android:textColor="#000000"/>

            </LinearLayout>

            <View
                android:layout_width="15dp"
                android:layout_height="0dp"/>

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="24dp"/>

        <!-- ===== Boton Registrar Entrada ===== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <View
                android:layout_width="16dp"
                android:layout_height="0dp"/>

            <TextView
                android:id="@+id/btn_registrar_entrada"

                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/fondo_boton"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="Registrar Entrada"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="28dp"/>

        <!-- ===== Titulo Historial de entradas ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Historial de entradas"
            android:textSize="17sp"
            android:textColor="#000000"/>

        <View
            android:layout_width="0dp"
            android:layout_height="16dp"/>

        <!-- ===== Lista del historial ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_historial"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:listitem="@layout/item_entrada_historial"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
