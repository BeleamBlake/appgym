<?xml version="1.0" encoding="utf-8"?>
<!-- CAMBIOS DE INTERFAZ CHIDO: ajustes visuales de color/fuente + boton de cerrar. -->


<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/fondo_registrar_entrada">

    <!-- Titulo + boton cerrar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tituloFormulario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/accent_red_dark"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="Registrar Entrada"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/btn_cerrar_registrar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_cerrar_x"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:elevation="20dp"/>

    </LinearLayout>

    <!-- Peso -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Peso (kg)"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/txtPeso"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Ingresar "
        android:textSize="16sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:inputType="numberDecimal"
        android:textColor="@color/text_primary"
        android:background="@drawable/fondo_edittext"
        android:layout_marginBottom="24dp" />

    <!-- Estatura -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estatura (mts)"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/txtEstatura"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Ingresar"
        android:textSize="16sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:inputType="numberDecimal"
        android:textColor="@color/text_primary"
        android:background="@drawable/fondo_edittext"
        android:layout_marginBottom="24dp" />

    <!-- Porcentaje de grasa -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Porcentaje de Grasa"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <!-- Fecha -->
    <EditText
        android:id="@+id/txtGrasa"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/fondo_edittext"
        android:clickable="false"
        android:focusable="false"
        android:hint="Calculando"
        android:inputType="numberDecimal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fecha"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/txtFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jun 5, 2023"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>


    <Button
        android:id="@+id/btnRegistrar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/accent_red"
        android:text="REGISTRAR"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        />

</LinearLayout>