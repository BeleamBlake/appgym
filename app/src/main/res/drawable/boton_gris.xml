<?xml version="1.0" encoding="utf-8"?>
    <!-- CAMBIOS DE INTERFAZ CHIDO: recurso visual. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:startColor="@color/surface_high"
        android:endColor="@color/surface" />

    <corners android:radius="24dp" />

    <stroke
        android:width="1dp"
        android:color="@color/border" />

    <padding
        android:top="10dp"
        android:bottom="10dp"
        android:left="16dp"
        android:right="16dp" />

</shape>
